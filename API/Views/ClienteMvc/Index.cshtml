@{
    Layout = null;
    ViewBag.Title = "Clientes";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        body { font-family: "Segoe UI", Arial, sans-serif; background: #f6f8ff; color: #1f2d5a; }
        .wrap { max-width: 980px; margin: 32px auto; padding: 0 16px; }
        .header { display: flex; align-items: center; justify-content: space-between; }
        .btn { background: #2f5fff; color: #fff; padding: 10px 16px; border-radius: 10px; text-decoration: none; font-weight: 600; }
        .btn:hover { background: #264fd1; }
        .card { background: #fff; border-radius: 14px; padding: 16px; box-shadow: 0 8px 20px rgba(24,36,79,0.08); margin-top: 16px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 10px; border-bottom: 1px solid #eef1ff; text-align: left; }
        .actions a { margin-right: 8px; }
        .link { color: #2f5fff; text-decoration: none; font-weight: 600; }
    </style>
</head>
<body>
<div class="wrap">
    <div class="header">
        <h1>Clientes</h1>
        <a class="btn" href="/cliente/create">Novo Cliente</a>
    </div>

    <div class="card">
        <table>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Endereço</th>
                <th>Ações</th>
            </tr>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.idCliente</td>
                    <td>@c.nomeCliente</td>
                    <td>@c.endereco</td>
                    <td class="actions">
                        <a class="link" href="/cliente/details/@c.idCliente">Detalhes</a>
                        <a class="link" href="/cliente/edit/@c.idCliente">Editar</a>
                        <a class="link" href="/cliente/delete/@c.idCliente">Excluir</a>
                    </td>
                </tr>
            }
        </table>
    </div>

    <p><a class="link" href="/">Voltar ao painel</a></p>
</div>
</body>
</html>
