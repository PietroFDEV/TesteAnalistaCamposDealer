@{
    Layout = null;
    ViewBag.Title = "Campos Dealer - Painel";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/Content/bootstrap.min.css" />
    <style>
        body {
            background: radial-gradient(circle at top left, #f5f7ff 0%, #eef2ff 40%, #ffffff 100%);
            font-family: "Segoe UI", Arial, sans-serif;
        }
        .hero {
            padding: 56px 24px 24px;
            text-align: center;
        }
        .hero h1 {
            font-size: 36px;
            font-weight: 700;
            color: #1f2d5a;
        }
        .hero p {
            font-size: 16px;
            color: #4c567a;
            max-width: 680px;
            margin: 12px auto 0;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
            padding: 24px;
            max-width: 980px;
            margin: 0 auto 40px;
        }
        .card-btn {
            border: 1px solid #e2e6f3;
            background: #ffffff;
            border-radius: 16px;
            padding: 20px;
            text-align: left;
            box-shadow: 0 6px 16px rgba(24, 36, 79, 0.08);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .card-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(24, 36, 79, 0.15);
        }
        .card-btn h3 {
            margin-top: 0;
            color: #1f2d5a;
        }
        .card-btn p {
            color: #5b668c;
        }
        .btn-large {
            display: inline-block;
            padding: 12px 18px;
            border-radius: 10px;
            background: #2f5fff;
            color: #fff;
            text-decoration: none;
            font-weight: 600;
        }
        .btn-large:hover { color: #fff; background: #264fd1; }
        .links {
            text-align: center;
            margin-bottom: 24px;
        }
        .links a {
            margin: 0 8px;
            color: #2f5fff;
            font-weight: 600;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="hero">
        <h1>Loja do Sr. Campos</h1>
        <p>Painel rápido para gerenciar Clientes, Produtos e Vendas com rastreabilidade e segurança.</p>
    </div>

    <div class="grid">
        <div class="card-btn">
            <h3>Clientes</h3>
            <p>Cadastre, edite e remova clientes.</p>
            <a class="btn-large" href="/cliente">Abrir Clientes</a>
        </div>
        <div class="card-btn">
            <h3>Produtos</h3>
            <p>Gerencie produtos e preços com histórico.</p>
            <a class="btn-large" href="/produto">Abrir Produtos</a>
        </div>
        <div class="card-btn">
            <h3>Vendas</h3>
            <p>Registre vendas com itens e totais.</p>
            <a class="btn-large" href="/venda">Abrir Vendas</a>
        </div>
    </div>

    <div class="links">
        <a href="/swagger/ui/index">Swagger</a>
    </div>
</body>
</html>
