@model TesteCamposDealer.DB.Produto

<h2>Novo Produto</h2>

@if (ViewBag.Erro != null)
{
    <p style="color:red">@ViewBag.Erro</p>
}

<form method="post">
    <label>Descrição</label>
    <input type="text" name="dscProduto" value="@Model?.dscProduto" required />

    <br />

    <label>Preço</label>
    <input type="number" step="0.01" name="vlrProduto" value="@Model?.vlrProduto" required />

    <br /><br />
    <button type="submit">Salvar</button>
</form>

<a href="/ProdutoMvc">Voltar</a>
