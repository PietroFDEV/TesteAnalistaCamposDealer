@{
    Layout = null;
    ViewBag.Title = "Detalhes do Produto";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        body { font-family: "Segoe UI", Arial, sans-serif; background: #f6f8ff; color: #1f2d5a; }
        .wrap { max-width: 680px; margin: 32px auto; padding: 0 16px; }
        .card { background: #fff; border-radius: 14px; padding: 20px; box-shadow: 0 8px 20px rgba(24,36,79,0.08); }
        .link { color: #2f5fff; text-decoration: none; font-weight: 600; }
    </style>
</head>
<body>
<div class="wrap">
    <h1>Detalhes do Produto</h1>
    <div class="card">
        <p><strong>ID:</strong> @Model.idProduto</p>
        <p><strong>Descrição:</strong> @Model.dscProduto</p>
        <p><strong>Preço:</strong> @Model.vlrProduto</p>
    </div>
    <p>
        <a class="link" href="/produto/edit/@Model.idProduto">Editar</a> |
        <a class="link" href="/produto">Voltar</a>
    </p>
</div>
</body>
</html>
